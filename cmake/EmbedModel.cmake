# The loader distributes only the signed Core DLL. Keep the default model in
# that DLL as RCDATA, independent of its filename or installation directory.
set(MEDICON_EMBEDDED_MODEL_DIR "${PROJECT_BINARY_DIR}/generated")
set(MEDICON_EMBEDDED_MODEL_RC "${MEDICON_EMBEDDED_MODEL_DIR}/medicon_neon.rc")
file(MAKE_DIRECTORY "${MEDICON_EMBEDDED_MODEL_DIR}")
set(_medicon_model_rc "// Generated by EmbedModel.cmake. RCDATA = resource type 10.\n")
set(_medicon_model_header "#pragma once\n#include <cstddef>\nnamespace medicon::custom_model::embedded_neon {\nstruct File { unsigned id; const char* path; const char* sha256; std::size_t size; };\ninline constexpr File files[] = {\n")
set(_medicon_model_identity "")

macro(medicon_embed_model_file resource_id relative_path expected_sha256)
    set(_model_path "${PROJECT_SOURCE_DIR}/assets/models/neon-t-pose/${relative_path}")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_model_path}")
    endif()
    file(SHA256 "${_model_path}" _model_sha256)
    if(NOT _model_sha256 STREQUAL "${expected_sha256}")
        message(FATAL_ERROR "Bundled Neon ${relative_path} differs from the supplied model")
    endif()
    file(SIZE "${_model_path}" _model_size)
    # Forward slashes work in both llvm-rc and Microsoft's resource compiler.
    file(TO_CMAKE_PATH "${_model_path}" _model_rc_path)
    string(REPLACE "\"" "\\\"" _model_rc_path "${_model_rc_path}")
    string(APPEND _medicon_model_rc "${resource_id} 10 \"${_model_rc_path}\"\n")
    string(APPEND _medicon_model_header "    {${resource_id}, \"${relative_path}\", \"${_model_sha256}\", ${_model_size}},\n")
    string(APPEND _medicon_model_identity "${relative_path}:${_model_sha256}\n")
endmacro()

medicon_embed_model_file(6100 model.fbx 8d036bc5e8ec3536e49a648113af2b281f9d5710b45deb3255cdd2f2994b2210)
medicon_embed_model_file(6101 model.json 80c4e2c956a1550419ae91c4867d4fad1a7cceb6c8beabf22606162739ac0b24)
medicon_embed_model_file(6102 textures/TP_Core_Eye_DF.png 44e642b418a2a12779db671f6cc1714ac969f2bb5d1c01136c89c4defda067d7)
medicon_embed_model_file(6103 textures/TP_Sprinter_S0_DF.png 7669f71750ab6b46af2e8b6e1e25f0d289cbf880542eaca7e3a2dac4aa4af111)
medicon_embed_model_file(6104 textures/TP_Sprinter_S0_Hair_DF.png 630549fb224bcde9d2a54b19a8c1390633f02b3ee2de0ac41a1f47266d523a26)
string(SHA256 _medicon_model_pack_id "${_medicon_model_identity}")
string(APPEND _medicon_model_header "};\ninline constexpr const char pack_id[] = \"${_medicon_model_pack_id}\";\n}\n")
file(CONFIGURE OUTPUT "${MEDICON_EMBEDDED_MODEL_RC}" CONTENT "${_medicon_model_rc}" @ONLY)
file(CONFIGURE OUTPUT "${MEDICON_EMBEDDED_MODEL_DIR}/medicon_embedded_model_manifest.hpp"
    CONTENT "${_medicon_model_header}" @ONLY)
