# The loader distributes only the signed Core DLL. Keep both model packs in
# that DLL as RCDATA, independent of its filename or installation directory.
set(MEDICON_EMBEDDED_MODEL_DIR "${PROJECT_BINARY_DIR}/generated")
set(MEDICON_EMBEDDED_MODEL_RC "${MEDICON_EMBEDDED_MODEL_DIR}/medicon_models.rc")
file(MAKE_DIRECTORY "${MEDICON_EMBEDDED_MODEL_DIR}")
set(_medicon_model_rc "// Generated by EmbedModel.cmake. RCDATA = resource type 10.\n")
set(_medicon_model_header "#pragma once\n#include <cstddef>\n#include <span>\nnamespace medicon::custom_model::embedded_models {\nstruct File { unsigned id; const char* path; const char* sha256; std::size_t size; };\nstruct Pack { const char* name; const char* directory; const char* cache_prefix; const char* sha256; std::span<const File> files; };\n")
set(_medicon_model_packs "")

macro(medicon_begin_model symbol directory display_name cache_prefix)
    set(_medicon_model_symbol "${symbol}")
    set(_medicon_model_directory "${directory}")
    set(_medicon_model_name "${display_name}")
    set(_medicon_model_cache_prefix "${cache_prefix}")
    set(_medicon_model_identity "")
    string(APPEND _medicon_model_header "inline constexpr File ${symbol}_files[] = {\n")
endmacro()

macro(medicon_embed_model_file resource_id relative_path expected_sha256)
    set(_model_path "${PROJECT_SOURCE_DIR}/assets/models/${_medicon_model_directory}/${relative_path}")
    if(NOT CMAKE_SCRIPT_MODE_FILE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_model_path}")
    endif()
    file(SHA256 "${_model_path}" _model_sha256)
    if(NOT _model_sha256 STREQUAL "${expected_sha256}")
        message(FATAL_ERROR "Bundled ${_medicon_model_name} ${relative_path} differs from the supplied model")
    endif()
    file(SIZE "${_model_path}" _model_size)
    # Forward slashes work in both llvm-rc and Microsoft's resource compiler.
    file(TO_CMAKE_PATH "${_model_path}" _model_rc_path)
    string(REPLACE "\"" "\\\"" _model_rc_path "${_model_rc_path}")
    string(APPEND _medicon_model_rc "${resource_id} 10 \"${_model_rc_path}\"\n")
    string(APPEND _medicon_model_header "    {${resource_id}, \"${relative_path}\", \"${_model_sha256}\", ${_model_size}},\n")
    string(APPEND _medicon_model_identity "${relative_path}:${_model_sha256}\n")
endmacro()

macro(medicon_end_model)
    string(SHA256 _medicon_model_pack_id "${_medicon_model_identity}")
    string(APPEND _medicon_model_header "};\n")
    string(APPEND _medicon_model_packs "    {\"${_medicon_model_name}\", \"${_medicon_model_directory}\", \"${_medicon_model_cache_prefix}\", \"${_medicon_model_pack_id}\", ${_medicon_model_symbol}_files},\n")
endmacro()

