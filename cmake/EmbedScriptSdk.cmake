set(MEDICON_EMBEDDED_SCRIPT_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated/scripts")
file(MAKE_DIRECTORY "${MEDICON_EMBEDDED_SCRIPT_DIR}")
set(_script_embedded "#pragma once\n#include <string_view>\n#include <utility>\nnamespace medicon::scripts::embedded {\n")
foreach(_pair "public_header|sdk/include/medicon.hpp" "abi_header|sdk/include/medicon/abi.h" "guide|docs/script-sdk.md")
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _name)
    list(GET _parts 1 _file)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${_file}")
    file(READ "${PROJECT_SOURCE_DIR}/${_file}" _text)
    string(APPEND _script_embedded "inline constexpr std::string_view ${_name} = R\"mcsdk(${_text})mcsdk\";\n")
endforeach()
file(GLOB_RECURSE _script_headers CONFIGURE_DEPENDS RELATIVE "${PROJECT_SOURCE_DIR}/sdk/include" "${PROJECT_SOURCE_DIR}/sdk/include/*")
string(APPEND _script_embedded "inline constexpr std::pair<std::string_view,std::string_view> headers[] = {\n")
foreach(_file IN LISTS _script_headers)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/sdk/include/${_file}")
    file(READ "${PROJECT_SOURCE_DIR}/sdk/include/${_file}" _text)
    string(APPEND _script_embedded "{\"${_file}\", R\"mcsdk(${_text})mcsdk\"},\n")
endforeach()
string(APPEND _script_embedded "};\n")
set(_script_docs
    01-getting-started.md 03-api-reference.md 11-liquid-glass.md 12-extended-api.md
    13-animation-and-ui.md 16-acceptance-tests-v02.md 18-internal-abi-sketch.md
    19-existing-liquid-glass-bridge.md 20-unified-overview.md internal/glass-renderer-inventory.md)
string(APPEND _script_embedded "inline constexpr std::pair<std::string_view,std::string_view> docs[] = {\n")
foreach(_file IN LISTS _script_docs)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/docs/${_file}")
    file(READ "${PROJECT_SOURCE_DIR}/docs/${_file}" _text)
    string(APPEND _script_embedded "{\"${_file}\", R\"mcsdk(${_text})mcsdk\"},\n")
endforeach()
string(APPEND _script_embedded "};\n")
file(GLOB_RECURSE _script_examples CONFIGURE_DEPENDS RELATIVE "${PROJECT_SOURCE_DIR}/sdk/examples" "${PROJECT_SOURCE_DIR}/sdk/examples/*")
string(APPEND _script_embedded "inline constexpr std::pair<std::string_view,std::string_view> examples[] = {\n")
foreach(_file IN LISTS _script_examples)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/sdk/examples/${_file}")
    file(READ "${PROJECT_SOURCE_DIR}/sdk/examples/${_file}" _text)
    string(APPEND _script_embedded "{\"${_file}\", R\"mcsdk(${_text})mcsdk\"},\n")
endforeach()
string(APPEND _script_embedded "};\n}\n")
file(CONFIGURE OUTPUT "${MEDICON_EMBEDDED_SCRIPT_DIR}/ScriptSdkEmbedded.hpp" CONTENT "${_script_embedded}" @ONLY)
