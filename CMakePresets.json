{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows",
      "cacheVariables": { "BUILD_TESTING": "ON", "MEDICON_BUILD_WINDOWS": "ON" }
    },
    {
      "name": "portable",
      "displayName": "Portable core (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/portable",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "MEDICON_BUILD_WINDOWS": "OFF", "BUILD_TESTING": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "windows", "configuration": "Release" },
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug" },
    { "name": "portable", "configurePreset": "portable" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "windows", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "windows", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "portable", "configurePreset": "portable", "output": { "outputOnFailure": true } }
  ]
}

