# メインサーバー（REST + WebSocket）。常に 127.0.0.1 で待ち受け、Cloudflare Tunnel がここへ転送する
PORT=8787
# 管理CLI用のHTTP。127.0.0.1 だけで待ち受け、Tunnel には載せない
ADMIN_PORT=8788
DB_PATH=./data/social.db
# 16文字以上のランダムな文字列。次のコマンドで作れる:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=
BACKUP_DIR=./backups

# Core DLL releases for MediconLoader (docs/auto-update.md). Both are needed to publish.
# npm run release:setup fills these, reusing an existing key or creating the first one.
# The private key stays on this server, outside version control.
RELEASE_SIGNING_KEY=
PUBLIC_BASE_URL=
