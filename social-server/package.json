{
  "name": "medicon-social-server",
  "version": "0.1.0",
  "private": true,
  "description": "Medicon Social server (REST + WebSocket), served through Cloudflare Tunnel",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "admin": "node admin/cli.ts",
    "test-client": "node tools/test-client.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "release:keygen": "node tools/release-keygen.ts",
    "release:sign": "node tools/release-sign.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
